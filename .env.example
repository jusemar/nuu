# URL-base pública do site (sem barra no final).
# É a fonte única do domínio usado em URL canônica, Open Graph e metadados.
# Desenvolvimento: http://localhost:3000
# Produção:        https://nooo.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth. O mesmo segredo server-side deriva HMACs não reversíveis dos
# desafios OTP; use valor aleatório forte e nunca o exponha com NEXT_PUBLIC_*.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Protege endpoints internos acionados por scheduler. Enviar como `Authorization: Bearer`.
CRON_SECRET=

# Origem logística Laquila. 83430000 é provisório até confirmação do fornecedor.
LAQUILA_CEP_ORIGEM=83430000
LAQUILA_CNPJ_LOJISTA=00000000000000

# Atendente IA — a chave é exclusivamente server-side.
OPENAI_API_KEY=
ATENDENTE_IA_ATIVO=false
ATENDENTE_IA_FERRAMENTAS_ATIVAS=false
ATENDENTE_IA_MEMORIA_ATIVA=false
ATENDENTE_IA_ESCALONAMENTO_ATIVO=false
ATENDENTE_IA_RAG_ATIVO=false
ATENDENTE_IA_ACOES_ATIVAS=false
ATENDENTE_IA_RECURSOS_EXPERIMENTAIS_ATIVOS=false
ATENDENTE_IA_PUBLICACOES_ADMIN_ATIVAS=false

# Número oficial da empresa no formato E.164 sem o prefixo "+", conforme o
# normalizador usado para gerar links wa.me. Configure o mesmo valor na Vercel.
ATENDENTE_IA_WHATSAPP_OFICIAL=5531988421694

# WhatsApp Cloud API da Meta — todas as credenciais são exclusivamente server-side.
# A versão deve ser informada explicitamente (por exemplo, vXX.X) para que upgrades
# da Graph API sejam conscientes e não mudem o transporte silenciosamente.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_API_VERSION=
WHATSAPP_META_OTP_TEMPLATE_NAME=
WHATSAPP_META_OTP_TEMPLATE_LANGUAGE=pt_BR

# ============================================
# BANCO DE DADOS — ver docs/ambientes-banco-e-scripts.md
# ============================================
# `.env` guarda APENAS a URL de producao, documentada. Nenhum comando local a usa como destino.
DATABASE_URL=

# `.env.local` (nao versionado) aponta o desenvolvimento local para a branch Neon de
# desenvolvimento. E o arquivo que o Next.js carrega com precedencia.
#   DATABASE_URL=postgresql://.../neondb?sslmode=require

# `.env.desenvolvimento.local` (nao versionado) e lido pelos scripts locais de banco.
# Sem ele, `npm run seed:*`, `import:*` e `manutencao:*` recusam executar.
#   DESENVOLVIMENTO_SEPARADO_DE_PRODUCAO=SIM
#   DATABASE_URL_DESENVOLVIMENTO=postgresql://.../neondb?sslmode=require
